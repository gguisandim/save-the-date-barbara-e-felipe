# Caminho para um volume persistente. Em desenvolvimento, o padrão é .data/invitations.sqlite.
INVITATIONS_DB_PATH=.data/invitations.sqlite

# Obrigatória em produção. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INVITATION_DATA_KEY=

# URL pública usada nos metadados Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
